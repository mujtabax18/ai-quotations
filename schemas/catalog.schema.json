{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quotation Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "updated_at",
    "total_quotations",
    "total_categories",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "content_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "total_quotations": {
      "type": "integer",
      "minimum": 0
    },
    "total_categories": {
      "type": "integer",
      "minimum": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "count",
          "file",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
